# 复制为 .env 后由 docker compose 自动加载
# 官方无 OpenProject 12.13.0；锁定 12 系列最终版 12.5.8 + PostgreSQL 13.21

COMPOSE_PROJECT_NAME=openproject-zh

OPENPROJECT_IMAGE_TAG=12.5.8
POSTGRES_IMAGE_TAG=13.21-bullseye
MEMCACHED_IMAGE_TAG=1.6.22-alpine

# 国内 Debian 镜像（构建期 ARG）
DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

TZ=Asia/Shanghai

# 宿主机端口：HOST:CONTAINER
PORT=8080
POSTGRES_PORT=5432

OPENPROJECT_HTTPS=false
OPENPROJECT_HSTS=false
OPENPROJECT_HOST__NAME=localhost:8080
OPENPROJECT_RAILS__RELATIVE__URL__ROOT=

# 生成: openssl rand -hex 64
SECRET_KEY_BASE=CHANGE_ME_GENERATE_WITH_OPENSSL

POSTGRES_USER=openproject
POSTGRES_PASSWORD=p4ssw0rd
POSTGRES_DB=openproject
DATABASE_URL=postgres://openproject:p4ssw0rd@db:5432/openproject?pool=20&encoding=unicode&reconnect=true

RAILS_MIN_THREADS=4
RAILS_MAX_THREADS=16
RAILS_LOG_TO_STDOUT=1

# 标准版 = 完整 CE 模块；切勿把 costs/reporting/budgets 写入 DISABLED
OPENPROJECT_EDITION=standard
OPENPROJECT_DEFAULT__LANGUAGE=zh-CN
OPENPROJECT_AVAILABLE__LANGUAGES=zh-CN,en
OPENPROJECT_DISABLED__MODULES=

# 新建项目默认启用：工作包 + 成本/工时（12.x 工时挂在 costs 模块）+ 成本报表 + 预算
OPENPROJECT_DEFAULT__PROJECTS__MODULES=work_package_tracking,news,wiki,calendar,gantt,costs,reporting,budgets,meetings,board_view,iext_enterprise

IMAP_ENABLED=false

# 数据与日志绑定到仓库目录（相对 compose 文件）
PGDATA=./data/postgres
OPDATA=./data/openproject
PGLOG=./logs/postgres
OPLOG=./logs/openproject
