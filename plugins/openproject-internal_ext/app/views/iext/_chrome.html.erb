<%# locals: title %>
<style>
  .iext-wrap { padding: 12px 16px; }
  .iext-help { color: #555; margin: 8px 0 16px; }
  .iext-heat { border-collapse: collapse; font-size: 12px; }
  .iext-heat th, .iext-heat td { border: 1px solid #ddd; padding: 4px 6px; text-align: center; }
  .iext-heat td.r0 { background: #f5f5f5; }
  .iext-heat td.r1 { background: #c8e6c9; }
  .iext-heat td.r2 { background: #fff59d; }
  .iext-heat td.r3 { background: #ef9a9a; }
  .iext-kpis { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0; }
  .iext-kpi { background: #fff; border: 1px solid #e0e0e0; padding: 12px 16px; min-width: 120px; }
  .iext-kpi b { display: block; font-size: 20px; }
  .iext-alert { color: #b71c1c; }
  .iext-toolbar { margin: 8px 0; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .iext-form input, .iext-form select, .iext-form textarea { margin: 0 6px 8px 0; }
</style>
<div class="iext-wrap">
  <h2><%= title %></h2>
  <p class="iext-help"><%= t('iext.help.native_kept') %> <%= t('iext.help.member_scope') %></p>
  <%= yield %>
</div>
